# Anthropic API key (required)
ANTHROPIC_API_KEY=your_api_key_here

# Optional: Override default model (default: claude-sonnet-4-20250514)
# ANTHROPIC_MODEL=claude-opus-4-20250514

# Optional: Custom API endpoint
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Optional: Anthropic Foundry (for custom deployments)
# ANTHROPIC_FOUNDRY_ENDPOINT=https://your-foundry-endpoint.com
# ANTHROPIC_FOUNDRY_API_KEY=your_foundry_key_here

# Optional: Filesystem access policy for the agent's read/write/skill tools.
#   readwrite  read + list + write + edit + save skills  (default for local CLI)
#   readonly   read + list only
#   off        no filesystem tools at all
# The web server always forces "off" for its hosted, multi-user sessions.
# LONGEVITYCLAW_FS=readwrite

# Optional: Primary workspace directory where relative paths resolve.
# Default: the repo's workspace/ folder. By default the agent may only access
# workspace/ and skills/; paths outside them are refused (no symlink/.. escapes).
# LONGEVITYCLAW_WORKSPACE=./workspace

# Optional: Extra directories/files the agent may access, beyond workspace/ and
# skills/ (os.pathsep-separated). Or grant interactively in the CLI with /grant.
# LONGEVITYCLAW_ALLOWED=/path/to/project:/path/to/data

# Optional: Default effort = max tool calls per normal response (skills bypass
# the cap). low=5, medium=10, high=20, max=unlimited. Change live with /effort.
# LONGEVITYCLAW_EFFORT=high

# Optional: Prompt-cache TTL for Anthropic models: "5m" (default) or "1h".
# 5m minimizes write cost during rapid agentic tool loops; 1h keeps the cached
# conversation alive across long between-turn reading pauses, so follow-ups read
# the prefix at 0.1× instead of re-writing it. Which is cheaper is workload-
# dependent — run the same flow under each and compare /usage's "saved". Ignored
# for non-Anthropic models (no explicit cache markers are sent there).
# LONGEVITYCLAW_CACHE_TTL=5m

# ---------------------------------------------------------------------------
# L-LLM (Longevity LLM) backend — powers the `query_llm` tool only. This is a
# separate, OpenAI-style chat endpoint, independent of the Anthropic agent above.
# ---------------------------------------------------------------------------

# Backend selector:
#   hf        HuggingFace Inference Endpoint (default)
#   local     self-hosted server; engine chosen by LOCAL_ENGINE below
#   vllm      shorthand for local + LOCAL_ENGINE=vllm
#   llamacpp  shorthand for local + LOCAL_ENGINE=llamacpp
# LLM_BACKEND=hf

# HuggingFace backend (used when LLM_BACKEND=hf). HF_TOKEN is required.
# HF_TOKEN=your_hf_token_here
# HF_ENDPOINT=https://your-endpoint.us-east-2.aws.endpoints.huggingface.cloud
# HF_MODEL=longevity-llm

# ── Self-hosted L-LLM (used when LLM_BACKEND=local/vllm/llamacpp) ───────────
# Serve the model behind an OpenAI-compatible API, then point VLLM_ENDPOINT at
# it. VLLM_MODEL must match the server's served-model-name (vLLM) or --alias
# (llama.cpp). The API key is OPTIONAL — set it only if the server was started
# with --api-key; otherwise the client sends a harmless placeholder.
#
# LOCAL_ENGINE selects how "thinking" is turned off, which differs by engine:
#   vllm      honours chat_template_kwargs.enable_thinking (bf16 official weights)
#   llamacpp  ignores that flag; the client uses the Qwen /no_think soft switch
#             (GGUF quant, e.g. mradermacher/longevity-llm-GGUF)
# LOCAL_ENGINE=vllm
# VLLM_ENDPOINT=http://localhost:8000      # alias: LOCAL_ENDPOINT
# VLLM_MODEL=longevity-llm
# VLLM_API_KEY=your_vllm_key_here          # optional

# Optional extra sampling params merged into every local request (JSON). The
# per-engine default already sends repetition_penalty/repeat_penalty = 1.1
# (required — the model loops without it). Override or extend here, e.g.:
# LOCAL_EXTRA_BODY={"top_p": 0.8, "top_k": 20}

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------

# Optional: NCBI E-utilities API key for PubMed search (raises rate limits;
# searches work without it, just slower).
# NCBI_API_KEY=your_ncbi_key_here

# Optional: stream the agent's answer token-by-token in the CLI. "1" (default)
# or "0" to disable streaming and print the full response at once.
# LONGEVITYCLAW_STREAM=1

# Optional: password for the web UI (longevityclaw-web). Equivalent to the
# --password flag; the flag takes precedence if both are set.
# LONGEVITYCLAW_PASSWORD=your_web_password
